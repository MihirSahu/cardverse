# Server-only CardAPI credential. Existing snapshots or curated fallback data remain readable when omitted.
CARDAPI_API_KEY=

# Local Drizzle/SQLite cache. Relative paths resolve from the project root.
CARDVERSE_DB_PATH=./data/cardverse.db

# List pagination and a hard safety ceiling across list/detail requests.
CARDAPI_PAGE_SIZE=100
CARDAPI_MAX_REFRESH_REQUESTS=30

# The local scheduler refreshes only when the last successful run is this old.
CARDAPI_REFRESH_INTERVAL_HOURS=24
CARDAPI_REFRESH_RETRY_HOURS=6
CARDAPI_REFRESH_STARTUP_DELAY_SECONDS=15
CARDAPI_REFRESH_DISABLED=false
